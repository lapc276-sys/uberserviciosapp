# ─────────────────────────────────────────────────────────────
# Homigo — Environment variables (copy to .env.local and fill in)
# Nothing here is required to run the marketing site in dev.
# Integrations activate automatically when their keys are present.
# ─────────────────────────────────────────────────────────────

# Public
NEXT_PUBLIC_SITE_URL=https://homigo.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# AI (chatbot + voice agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database (Supabase / Postgres)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Messaging
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Cache / queue
REDIS_URL=
