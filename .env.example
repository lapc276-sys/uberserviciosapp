# ─────────────────────────────────────────────────────────────
# Homigo — Environment variables (copy to .env.local and fill in)
# Nothing here is required to run the marketing site in dev.
# Integrations activate automatically when their keys are present.
# ─────────────────────────────────────────────────────────────

# Public
NEXT_PUBLIC_SITE_URL=https://homigo.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# AI (chatbot + voice agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Vision model for the video-walkthrough quote (must be multimodal).
# Without a key the flow still runs, in clearly-labeled demo mode.
OPENAI_VISION_MODEL=gpt-4o

# Database (Supabase / Postgres). Set to enable persistence.
# Example (Supabase): postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (admin panel). AUTH_SECRET is REQUIRED in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=
# Bootstrap admin login (works with zero database).
ADMIN_EMAIL=admin@homigo.com
ADMIN_PASSWORD=ChangeMe123!

# Payments (Stripe). Webhook: /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Messaging
RESEND_API_KEY=
# Verified sender, e.g. "Homigo <hello@homigo.com>"
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Delivery (laundry) intake: point the SAME Twilio number's *messaging* webhook
# at /api/delivery/sms. Inbound texts become orders with a card-on-file link.
# Voice AI agent. Point your Twilio number's voice webhook at /api/voice/incoming
# and its status callback at /api/voice/status.
# Amazon Polly neural voice used for speech (see Twilio's voice list).
TWILIO_VOICE=Polly.Joanna-Neural
# Optional: number to transfer callers to when they ask for a human.
VOICE_TRANSFER_NUMBER=

# WhatsApp Cloud API (Meta). Webhook: /api/whatsapp
# VERIFY_TOKEN is any string you choose; enter the same one in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Facebook Messenger + Instagram DMs (Meta). Webhook: /api/meta/messenger
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
META_IG_TOKEN=
META_APP_SECRET=

# Google
# Geocoding for delivery addresses. Without it orders are still created — they
# just can't be dispatched until someone pins the location.
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Cache / queue
REDIS_URL=

# Cron protection (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
