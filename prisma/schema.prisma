// Homigo data model (Phase 2)
// Provider: PostgreSQL (Supabase-compatible). Set DATABASE_URL to activate.
// Designed to be vertical-agnostic: `serviceSlug`/`vertical` are strings so
// the same tables power cleaning today and painting/moving/etc. tomorrow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DISPATCHER
  STAFF
}

enum BookingStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum Frequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

// Internal users (admin panel). Bootstrap admin can also come from env.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  createdAt DateTime  @default(now())
  addresses Address[]
  bookings  Booking[]
  reviews   Review[]

  @@index([email])
}

model Address {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  line1      String
  city       String
  region     String    @default("FL")
  postalCode String?
  notes      String?
  bookings   Booking[]
}

enum ProStatus {
  APPLIED
  APPROVED
  SUSPENDED
}

/**
 * An independent service professional on the marketplace.
 * Deliberately NOT called "Employee": pros are independent contractors who
 * apply, choose their own service areas, and are free to accept or decline
 * each job offer. That right to decline is modeled explicitly via JobOffer —
 * it is a core marketplace mechanic and a factor in worker classification.
 * Confirm your classification approach with employment counsel per state.
 */
model Pro {
  id              String    @id @default(cuid())
  name            String
  /**
   * Public handle for /p/<handle> — the address a badge QR points at.
   * Stable for the life of the pro: a printed code cannot be reissued.
   */
  handle          String?   @unique
  /**
   * Whether this pro currently wants new work through their badge.
   * A pro with a full book still wears the shirt. Turning intake off has to
   * route the job elsewhere while still crediting the scan, or the rational
   * move once you are busy is to stop wearing it.
   */
  acceptingWork   Boolean   @default(true)
  email           String    @unique
  phone           String?
  status          ProStatus @default(APPLIED)
  rating          Float     @default(5)
  /**
   * City slugs this pro serves, e.g. ["manhattan-ny","brooklyn-ny"].
   */
  serviceAreas    String[]  @default([])
  yearsExperience Int       @default(0)
  hasTransport    Boolean   @default(false)
  bio             String?
  /**
   * Stripe Connect account for payouts (Phase 7).
   */
  stripeAccountId String?
  createdAt       DateTime  @default(now())

  bookings Booking[]
  offers   JobOffer[]
  payouts  Payout[]

  @@index([status])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

/**
 * A job offered to a pro. First to accept wins; the rest expire.
 */
model JobOffer {
  id          String      @id @default(cuid())
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  pro         Pro         @relation(fields: [proId], references: [id], onDelete: Cascade)
  proId       String
  status      OfferStatus @default(PENDING)
  sentAt      DateTime    @default(now())
  respondedAt DateTime?

  @@unique([bookingId, proId])
  @@index([status])
}

model Booking {
  id               String        @id @default(cuid())
  ref              String        @unique // human-friendly, e.g. HMG-8F2A
  vertical         String        @default("cleaning")
  serviceSlug      String
  serviceName      String
  bedrooms         Int           @default(0)
  bathrooms        Int           @default(0)
  sqft             Int           @default(0)
  frequency        Frequency     @default(ONE_TIME)
  date             String // ISO date (YYYY-MM-DD)
  time             String
  quoteLow         Int?
  quoteHigh        Int?
  /**
   * Labour minutes the quote was built from. Shown to the pro before they
   * accept: a payout figure without a duration is not a decidable offer.
   */
  estimatedMinutes Int?
  status           BookingStatus @default(SCHEDULED)
  notes            String?
  createdAt        DateTime      @default(now())

  /**
   * Minutes the pro actually worked. Ground truth for calibrating the AI
   * time model — compare against VisionAnalysis.predictedMinutes.
   */
  actualMinutes Int?

  // Marketing attribution (first touch) and applied offer.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  promoCode   String?
  discount    Int? // USD off the subtotal

  // Automation lifecycle flags — guard against double-sends.
  remind24Sent      Boolean @default(false)
  remind2Sent       Boolean @default(false)
  reviewRequestSent Boolean @default(false)
  followUpSent      Boolean @default(false)

  customer       Customer        @relation(fields: [customerId], references: [id])
  customerId     String
  address        Address?        @relation(fields: [addressId], references: [id])
  addressId      String?
  pro            Pro?            @relation(fields: [proId], references: [id])
  proId          String?
  invoice        Invoice?
  review         Review?
  photos         Photo[]
  offers         JobOffer[]
  visionAnalysis VisionAnalysis?
  payout         Payout?

  @@index([status])
  @@index([createdAt])
  @@index([date])
  @@index([proId])
  @@index([utmSource])
}

// Before/after service photos (stored in Supabase Storage / S3; URL kept here).
model Photo {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  url       String
  kind      String   @default("after") // before | after
  createdAt DateTime @default(now())
}

model Invoice {
  id        String        @id @default(cuid())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String        @unique
  amount    Int
  status    InvoiceStatus @default(DRAFT)
  stripeId  String?
  createdAt DateTime      @default(now())
}

model Review {
  id         String   @id @default(cuid())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

/**
 * A completed AI walkthrough analysis.
 * `predictedMinutes` vs. the linked booking's `actualMinutes` is the training
 * signal for calibrating lib/vision/model.ts. Without capturing actuals the
 * time model can never improve, so this relationship is the point of the table.
 */
model VisionAnalysis {
  id               String   @id @default(cuid())
  serviceSlug      String
  city             String?
  frameCount       Int
  roomCount        Int
  predictedMinutes Int
  condition        String
  confidence       Float
  source           String // vision-llm | heuristic
  quoteLow         Int
  quoteHigh        Int
  /**
   * Full analysis payload (rooms, objects, soil scores) for auditing.
   */
  payload          Json
  contactEmail     String?
  createdAt        DateTime @default(now())

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?  @unique

  @@index([createdAt])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

/**
 * A pro's earnings for one job. Created when the booking completes and
 * reconciled against Stripe. Unique per booking so a job can only ever
 * generate one payout, however many times completion is triggered.
 */
model Payout {
  id               String       @id @default(cuid())
  booking          Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId        String       @unique
  pro              Pro          @relation(fields: [proId], references: [id])
  proId            String
  amount           Int // cents
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  failureReason    String?
  createdAt        DateTime     @default(now())
  paidAt           DateTime?

  @@index([status])
  @@index([proId])
}

/**
 * A labeled capture from a real job — the training asset.
 * The valuable record is not the footage, it is the PAIR: what the model
 * predicted and what the person standing in the room corrected it to, plus how
 * long the work actually took. That pair is the only thing that improves the
 * model, and it can't be bought or scraped.
 * `consent*` is mandatory, not decorative: footage of someone's home without
 * recorded permission is a liability, never an asset.
 */
model TrainingSample {
  id           String  @id @default(cuid())
  capturedBy   String // pro id or admin email
  serviceSlug  String
  city         String?
  propertyType String  @default("residential")

  // Consent record — who agreed, and when.
  consentName     String
  consentAt       DateTime
  /**
   * Whether the customer agreed the footage may improve the model.
   */
  consentTraining Boolean  @default(false)

  frameCount Int
  /**
   * The model's raw analysis.
   */
  predicted  Json
  /**
   * The human-corrected analysis — the label.
   */
  corrected  Json

  predictedMinutes    Int
  /**
   * Person-minutes spent on the tasks themselves.
   * What a stopwatch-per-activity measures, and what ActivitySegment sums.
   */
  actualMinutes       Int
  /**
   * Person-minutes from arriving to leaving.
   * The two are not the same number and the gap is not small: travel between
   * rooms, unpacking and repacking supplies, moving furniture, setup and
   * teardown run 20-40% of a cleaning day. A stopwatch never counts them and
   * an invoice always does.
   * Until this exists the time model cannot be calibrated at all, because the
   * thing it predicts (billable time) and the thing that was measured (task
   * time) are different quantities. One field, and it unblocks the rest.
   */
  onSiteMinutes       Int?
  /**
   * Mean absolute soil-score correction across all rooms, 0-100.
   */
  correctionMagnitude Float @default(0)

  /**
   * Operator context — the signal nobody outside the operation can collect.
   * The same bathroom at the same soil level does not take the same time at
   * 9am as it does on someone's fourth job of the day. Capturing who worked,
   * how far into their day they were, and how many hands were on the job is
   * what lets the time model explain variance that pure vision never will.
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /** 1 = first job of that worker's day, 2 = second, etc.
   */
  jobSequence      Int?
  /**
   * Hours already worked before starting this job.
   */
  hoursWorkedToday Float?
  /**
   * People on the job. actualMinutes is person-minutes, so this is separate.
   */
  crewSize         Int    @default(1)
  /**
   * Local hour the job started, 0-23.
   */
  startHour        Int?

  /**
   * Measured floor area, when someone paced it out. Denormalised out of the
   * corrected JSON so "does area predict time" is a query rather than a scan
   * that parses every sample.
   */
  totalAreaSqft Int?

  /**
   * Post-service analysis, for quality scoring.
   */
  afterAnalysis Json?
  /**
   * 0-100 improvement score derived from before vs. after.
   */
  qualityScore  Float?

  notes     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([serviceSlug])
  @@index([jobSequence])
}

/**
 * Spent magic-link tokens, so a sign-in link can only be used once.
 */
model UsedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Marketing opt-out list. Checked before any promotional send (CAN-SPAM).
model OptOut {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Every quote/chat/contact intent is captured as a Lead for follow-up.
model Lead {
  /**
   * The pro whose badge was scanned, when a lead arrived that way.
   * Recorded even when somebody else ends up doing the job — the referral is
   * the thing being rewarded, not the labour.
   */
  referredByProId String?
  id              String   @id @default(cuid())
  name            String?
  email           String?
  phone           String?
  source          String   @default("web") // web | chatbot | contact | voice
  message         String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/**
 * A company licensing the quoting engine.
 * The marketplace is tenant zero; every other row is a cleaning company that
 * pays for the API. Pricing and calibration are JSON because they are settings,
 * not relations — a new knob is a code change in lib/tenants/types.ts, never a
 * migration, which matters when the shape is still being learned from customers.
 */
model Tenant {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  contactEmail String
  /**
   * Where a new lead is texted, when they gave a number.
   *
   * Optional because email always works and a phone number is the one field
   * that makes somebody abandon a signup form. The notifier falls back to
   * email alone when this is empty.
   */
  contactPhone String?
  plan         String  @default("trial")
  active       Boolean @default(true)
  monthlyQuota Int     @default(50)

  /**
   * SHA-256 of the API key. The key itself is shown once and never stored.
   */
  keyHash  String @unique
  /**
   * Last 4 chars, so a key can be identified in the UI without revealing it.
   */
  keyLast4 String

  /**
   * TenantPricing — rate, minimum, currency, tax, supply multiplier.
   */
  pricing     Json
  /**
   * TenantCalibration — the time model fitted to this tenant's own actuals.
   */
  calibration Json
  /**
   * TenantBranding — display name, logo, color for the embedded widget.
   */
  branding    Json

  createdAt DateTime      @default(now())
  usage     TenantUsage[]
  leads     TenantLead[]

  @@index([createdAt])
}

/**
 * Metered usage per tenant per calendar month (UTC), for billing and quota.
 */
model TenantUsage {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * "YYYY-MM", UTC.
   */
  period      String
  quotes      Int    @default(0)
  /**
   * Sum of quoted midpoints in the tenant's currency — their ROI, and ours.
   */
  quotedValue Float  @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, period])
  @@index([period])
}

/**
 * A quote request from a tenant's own customer, captured on their hosted page.
 * This is the tenant's lead, not ours. We store it so their dashboard can show
 * it and so a failed notification isn't a lost customer, but the relationship
 * belongs to them — which is also why nothing here is ever aggregated across
 * tenants or sold.
 */
model TenantLead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  address String?
  notes   String?

  serviceSlug String
  /**
   * The quote shown to the customer, in the tenant's currency.
   */
  quoteLow    Int
  quoteHigh   Int
  currency    String  @default("USD")
  minutes     Int
  condition   String?

  /**
   * Full analysis, so the tenant can see what the AI actually saw.
   */
  analysis Json?

  /**
   * new | contacted | won | lost
   */
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/**
 * One job, logged live from the field by chat.
 * Separate from Booking on purpose: these are recorded on jobs the operator
 * finds themselves, long before the platform has any bookings of its own, and
 * the whole reason they exist is to produce labelled minutes for the time
 * model when there is nothing else to learn from.
 */
/**
 * The person whose pace is being learned — once, whether they log from the
 * web timer or from Telegram. Before this existed the same cleaner was two
 * people (an email and a chat id), and a per-person number split in half is
 * two numbers that each need twice as long to mean anything.
 *
 * Deliberately no age, sex, body or nationality fields. See
 * docs/APRENDIZAJE.md §5b: the person's own measured work beats any group
 * average after eight rooms, so those columns would only add noise to the
 * dataset that is the asset.
 */
model Worker {
  id             String   @id @default(cuid())
  /**
   * The cleaning company this person works for. Null = Klaudy.
   */
  tenantId       String?
  /**
   * The marketplace pro this is, when they are one. Not a foreign key, like
   * VisionFrameArchive.analysisId: a pro row can go for its own reasons.
   */
  proId          String?  @unique
  email          String?  @unique
  telegramChatId String?  @unique
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  sessions ActivitySession[]

  @@index([tenantId])
}

model ActivitySession {
  id          String  @id @default(cuid())
  /**
   * Telegram chat id or admin email — whoever logged it.
   */
  loggedBy    String
  label       String?
  serviceSlug String?

  /**
   * Who worked. Kept beside loggedBy, which stays for rows from before this.
   */
  workerId   String?
  worker     Worker? @relation(fields: [workerId], references: [id])
  /**
   * The quote this job was priced from — the "predicted" half of every ratio
   * the pace model learns from. Not a foreign key, for the same reason as the
   * frame archive's.
   */
  analysisId String?
  /**
   * field | practice | test. `test` never reaches a calculation; the filter
   * lives in one place (lib/workers/pace.ts) so it cannot be forgotten in one.
   */
  source     String  @default("field")
  /**
   * City of the property, copied from the analysis — the region of the
   * global prior.
   */
  region     String?
  /**
   * People on the job. Segments are per person; this is the context.
   */
  crewSize   Int     @default(1)
  /**
   * Optional answer at the door: good | normal | tired. Recorded, not yet
   * used for estimates — see docs/APRENDIZAJE.md §3d.
   */
  arrivalFeeling String?
  /**
   * Closed after the fact — "Me voy" was forgotten and the job was closed when
   * the next one started. Its end is set to the last room's end, so its rooms
   * still count; its door-to-door does not, because the packing-up at the end
   * was never seen and overhead is exactly the number being measured.
   */
  closedLate     Boolean @default(false)

  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  /**
   * Sum of the closed segments. Denormalised so reports don't re-add them.
   */
  totalMinutes Int?

  notes         String?
  segments      ActivitySegment[]
  qualityChecks QualityCheck[]
  recordings    JobRecording[]

  @@index([loggedBy, startedAt])
  @@index([workerId, startedAt])
  @@index([analysisId])
}

/**
 * One room, or one task inside a room, with a real start and end.
 */
model ActivitySegment {
  id        String          @id @default(cuid())
  sessionId String
  session   ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  roomType String
  /**
   * Free-form detail the person said, e.g. "cocina el horno".
   */
  task     String?

  /**
   * Which room of the walkthrough ("bathroom-2"), not just which kind — so the
   * minutes can be set against the prediction for that very room.
   */
  roomKey          String?
  /**
   * A paid extra timed on its own: a catalogue object plus its depth, e.g.
   * oven + deep = "el horno por dentro". Never free text.
   */
  taskKey          String?
  depth            String?
  /**
   * What the engine predicted for this room or extra, frozen when the segment
   * started. If the constants change tomorrow, today's ratio still means what
   * it meant today.
   */
  predictedMinutes Float?
  /**
   * Two people in the same room at once: counts for the company, not for
   * either person's pace.
   */
  together         Boolean @default(false)
  /**
   * Marked wrong ("left the timer running through lunch"). Marked, never
   * deleted: a record that can be edited without a trace is not ground truth.
   */
  excluded         Boolean @default(false)
  excludedReason   String?

  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?

  @@index([sessionId])
  @@index([roomType])
}

/**
 * Video of a job, recorded hands-free from a phone on the head or chest. The
 * RAW layer of the dataset (docs/DATOS.md): written once, never edited.
 *
 * startedAt is the phone's t0 placed on the server clock, so a room
 * segment's startedAt minus this startedAt is where that room or object
 * begins in the video. That one subtraction is what lets the footage be cut
 * per object later — and what turns a job into labelled demonstrations
 * rather than three hours of film.
 *
 * The bytes live in an S3-compatible bucket (lib/storage/s3.ts) as
 * independent 30-second segments, uploaded by the phone directly. Without a
 * bucket they stay on the phone, are exported as a ZIP, and can be ingested
 * later (pipeline: ingest-zip); this row records that they exist either way.
 */
model JobRecording {
  id           String          @id @default(cuid())
  sessionId    String
  session      ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /**
   * The recording's t=0 on the SERVER clock. Every offset below — segment,
   * sensor sample, event — is milliseconds from this instant on the phone's
   * monotonic clock, and `clockOffsetMs` turns phone time into server time.
   */
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  mimeType     String
  /** Configured length of each independent video segment. */
  chunkSeconds Int
  /**
   * Bucket prefix: <prefix>/video/00001.webm, <prefix>/sensors/00001.jsonl.gz.
   * Null when the recording stayed on the phone.
   */
  storagePrefix String?
  /** Server UTC minus the phone's clock, from the best of several round trips. */
  clockOffsetMs Float?
  /** That round trip: the offset is good to about half of it. */
  clockRttMs    Float?
  /** What the camera actually delivered: width, height, frameRate, facingMode, bitrate. */
  capture       Json?
  /** The phone: user agent, platform, memory, cores, screen. No identifiers. */
  device        Json?
  /** Audio is off unless a consent says otherwise; recorded here either way. */
  audio         Boolean  @default(false)
  createdAt     DateTime @default(now())

  segments     VideoSegment[]
  sensorChunks SensorChunk[]
  events       RecordingEvent[]
  frames       ExtractedFrame[]

  @@index([sessionId])
}

/**
 * One independently playable piece of a recording, as uploaded. RAW: written
 * once when the phone confirms the upload and never edited afterwards. What
 * the pipeline later thinks of it goes to QualityFinding, not here.
 */
model VideoSegment {
  id          String       @id @default(cuid())
  recordingId String
  recording   JobRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  index       Int
  objectKey   String
  mimeType    String
  bytes       Int
  /** Computed on the phone before upload; the pipeline re-checks the object against it. */
  sha256      String
  /** Phone monotonic ms from the recording's t=0. Segments may overlap by a few ms: none is lost. */
  monoStartMs Float
  monoEndMs   Float
  uploadedAt  DateTime     @default(now())

  frames ExtractedFrame[]

  @@unique([recordingId, index])
  @@index([sha256])
}

/**
 * Accelerometer, gyroscope and orientation, as gzipped JSONL in the bucket
 * (format in lib/recording/format.ts). RAW. Samples are not rows: three hours
 * at 60 Hz is 650,000 of them per recording.
 *
 * Lined up with the video by TIME, not by index: the sensors keep running
 * through a privacy pause, when there is no video segment to pair with.
 */
model SensorChunk {
  id          String       @id @default(cuid())
  recordingId String
  recording   JobRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  index       Int
  objectKey   String
  bytes       Int
  sha256      String
  samples     Int
  /** e.g. ["motion", "orientation"] — what the phone could provide. */
  streams     String[]
  monoStartMs Float
  monoEndMs   Float
  uploadedAt  DateTime     @default(now())

  @@unique([recordingId, index])
}

/**
 * Everything that happened to a recording that is not a frame: interruptions
 * (screen hidden, camera lost, offline, page closed), privacy pauses, and a
 * telemetry snapshot per segment (battery, storage, track settings). RAW.
 */
model RecordingEvent {
  id          String        @id @default(cuid())
  recordingId String?
  recording   JobRecording? @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  sessionId   String?
  /**
   * The phone's own counter. With the unique index below it makes sending an
   * event twice harmless — a retry, a beacon from a closing page and a
   * recovery the next morning can all carry the same event. Null for events
   * the server writes itself.
   */
  seq         Int?
  kind        String
  /** Phone monotonic ms from the recording's t=0, when there is a recording. */
  monoMs      Float?
  clientUtcMs Float?
  serverAt    DateTime      @default(now())
  data        Json?

  @@unique([recordingId, seq])
  @@index([recordingId, serverAt])
  @@index([kind])
}

/**
 * Who agreed to what, in which words. A recording without both a worker
 * consent and a customer authorisation is refused by the API, and a dataset
 * row without its consent trail is worth nothing to anyone who audits it.
 */
model RecordingConsent {
  id          String    @id @default(cuid())
  /** worker | customer */
  kind        String
  workerId    String
  /** The job, for a customer authorisation; null for the worker's own standing consent. */
  sessionId   String?
  /** Version of the wording, e.g. "2026-11-v1". */
  version     String
  statement   String
  video       Boolean   @default(true)
  audio       Boolean   @default(false)
  givenAt     DateTime  @default(now())
  withdrawnAt DateTime?
  /** Who pressed the button: the worker, attesting for the customer when kind = customer. */
  recordedBy  String

  @@index([workerId, kind])
  @@index([sessionId])
}

/**
 * A frame the pipeline pulled out of a segment. DERIVED and reproducible:
 * the same segment, method and pipeline version give the same frames, each
 * pointing back at its source and its exact presentation time.
 */
model ExtractedFrame {
  id              String       @id @default(cuid())
  recordingId     String
  recording       JobRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  segmentId       String
  segment         VideoSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  /** Presentation time inside the segment, from the container. */
  ptsMs           Float
  /** From the recording's t=0: the segment's start plus the pts. */
  offsetMs        Float
  objectKey       String
  width           Int
  height          Int
  sha256          String
  /** uniform | scene | motion */
  method          String
  pipelineVersion String
  createdAt       DateTime     @default(now())

  @@unique([segmentId, ptsMs, method, pipelineVersion])
  @@index([recordingId, offsetMs])
}

/**
 * Exactly which model said something: provider, model, version, prompt
 * version and the configuration it ran with. An annotation from "gpt-4o"
 * means nothing a year later; one from this row can be reproduced or
 * discounted.
 */
model ModelVersion {
  id            String   @id @default(cuid())
  provider      String
  model         String
  version       String
  promptVersion String   @default("")
  configHash    String
  config        Json
  createdAt     DateTime @default(now())

  annotations Annotation[]

  @@unique([provider, model, version, promptVersion, configHash])
}

/**
 * Every interpretation of a recording, from any source, in one timeline.
 *
 * APPEND-ONLY. A human correcting a model does not edit the model's row: a
 * new row is written with source "human" and `supersedesId` pointing at it.
 * The prediction, the correction and who made it all survive — which is
 * what makes "how often is the model wrong" a query instead of a memory.
 *
 * kind: activity | action | task | object | surface | room | difficulty |
 *       effort | quality | environment
 * source: machine | worker | human
 * reviewStatus: unreviewed | accepted | rejected | corrected
 *
 * Worker declarations made live (voice markers, timer taps) stay where they
 * were recorded, in ActivitySegment; exports present them as source "worker".
 */
model Annotation {
  id             String        @id @default(cuid())
  kind           String
  label          String
  recordingId    String?
  sessionId      String?
  startOffsetMs  Float?
  endOffsetMs    Float?
  startAt        DateTime?
  endAt          DateTime?
  activeMs       Int?
  waitingMs      Int?
  repetitions    Int?
  objectKey      String?
  surface        String?
  roomKey        String?
  tools          String[]
  /** Lighting, occupancy, pets — whatever the environment was. */
  conditions     Json?
  /** Kind-specific scores: difficulty indicators, effort scales, quality marks. */
  attributes     Json?
  /** Frames and segments this rests on: [{ segmentId, ptsMs }]. */
  frameRefs      Json?
  confidence     Float?
  source         String
  reviewStatus   String        @default("unreviewed")
  modelVersionId String?
  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id])
  /** The worker or admin who made it, for worker and human sources. */
  annotatorId    String?
  supersedesId   String?
  supersedes     Annotation?   @relation("Correction", fields: [supersedesId], references: [id])
  supersededBy   Annotation[]  @relation("Correction")
  createdAt      DateTime      @default(now())

  @@index([recordingId, startOffsetMs])
  @@index([sessionId])
  @@index([kind, label])
  @@index([supersedesId])
}

/**
 * What the pipeline found wrong with the data — never fixed by guessing.
 * The full list of kinds, with what each means, is KINDS in
 * pipeline/klaudy_pipeline/findings.py (e.g. checksum_mismatch,
 * missing_segment, corrupt_video, video_gap, sensor_gap, clock_untrusted).
 * A finding is resolved by setting resolvedAt, never by deleting it.
 */
model QualityFinding {
  id              String    @id @default(cuid())
  recordingId     String?
  sessionId       String?
  segmentId       String?
  kind            String
  /** info | warning | error */
  severity        String
  details         Json?
  pipelineVersion String
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([recordingId])
  @@index([kind])
}

/**
 * The work queue between the app and the Python pipeline. Postgres rather
 * than Redis at this scale: one less service to run, and FOR UPDATE SKIP
 * LOCKED gives the same "one worker per job" guarantee. Redis is the move
 * when jobs per second, not jobs per day, is the number.
 */
model ProcessingJob {
  id          String    @id @default(cuid())
  /** validate_recording | extract_frames | summarize_sensors | export_dataset */
  kind        String
  payload     Json
  /** queued | running | done | failed */
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAfter])
}

/**
 * An immutable export: JSONL and Parquet files plus a manifest with their
 * checksums, under datasets/<name>/v<version>/ in the bucket. A model
 * trained on "v7" can always be traced to exactly the rows it saw.
 */
model DatasetVersion {
  id              String   @id @default(cuid())
  name            String
  version         Int
  description     String?
  filters         Json
  codeVersion     String
  pipelineVersion String
  manifestKey     String
  counts          Json
  createdAt       DateTime @default(now())

  @@unique([name, version])
}

/** Every read, export or deletion of raw recordings, by whom and why. */
model DataAccessLog {
  id        String   @id @default(cuid())
  actor     String
  /** read | export | delete */
  action    String
  resource  String
  reason    String?
  createdAt DateTime @default(now())

  @@index([resource])
  @@index([createdAt])
}

/**
 * Whether the work was good enough to count. A fast room that had to be
 * redone is not fast, and the pace model skips it.
 */
model QualityCheck {
  id        String          @id @default(cuid())
  sessionId String
  session   ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /**
   * The room checked, or null for the whole job.
   */
  roomKey   String?
  /**
   * ok | redo
   */
  result    String
  /**
   * customer | photos | worker | supervisor
   */
  by        String
  /**
   * 0-100, when it came from the before/after photos or a rating.
   */
  score     Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([sessionId])
}

/**
 * Frames kept for training, when the operator has switched archiving on and
 * the customer consented. See lib/vision/archive.ts for why this is opt-in and
 * time-bounded rather than a default.
 */
model VisionFrameArchive {
  id         String   @id @default(cuid())
  /**
   * The VisionAnalysis this frame belongs to. Not a foreign key: an analysis
   * may be deleted for its own reasons, and orphaning the frames would leave
   * them undeletable by the one handle anybody has for them.
   */
  analysisId String
  /**
   * Order within the walkthrough, so the set can be reassembled.
   */
  position   Int
  /**
   * What the camera was aimed at, e.g. "[kitchen-1] kitchen - Dentro del
   * horno". The label half of a training pair.
   */
  caption    String?
  /**
   * thumbnail | full — which archive mode produced this row.
   */
  kind       String
  /**
   * The image as a data URL.
   */
  data       String
  /**
   * Hard deletion date, written at insert. A scheduled purge enforces it.
   */
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([analysisId])
  @@index([expiresAt])
}
