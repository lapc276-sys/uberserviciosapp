// Homigo data model (Phase 2)
// Provider: PostgreSQL (Supabase-compatible). Set DATABASE_URL to activate.
// Designed to be vertical-agnostic: `serviceSlug`/`vertical` are strings so
// the same tables power cleaning today and painting/moving/etc. tomorrow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DISPATCHER
  STAFF
}

enum BookingStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum Frequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

// Internal users (admin panel). Bootstrap admin can also come from env.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  createdAt DateTime  @default(now())
  addresses Address[]
  bookings  Booking[]
  reviews   Review[]

  @@index([email])
}

model Address {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  line1      String
  city       String
  region     String    @default("FL")
  postalCode String?
  notes      String?
  bookings   Booking[]
}

enum ProStatus {
  APPLIED
  APPROVED
  SUSPENDED
}

/**
 * An independent service professional on the marketplace.
 * Deliberately NOT called "Employee": pros are independent contractors who
 * apply, choose their own service areas, and are free to accept or decline
 * each job offer. That right to decline is modeled explicitly via JobOffer —
 * it is a core marketplace mechanic and a factor in worker classification.
 * Confirm your classification approach with employment counsel per state.
 */
model Pro {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  status          ProStatus @default(APPLIED)
  rating          Float     @default(5)
  /**
   * City slugs this pro serves, e.g. ["manhattan-ny","brooklyn-ny"].
   */
  serviceAreas    String[]  @default([])
  yearsExperience Int       @default(0)
  hasTransport    Boolean   @default(false)
  bio             String?
  /**
   * Stripe Connect account for payouts (Phase 7).
   */
  stripeAccountId String?
  createdAt       DateTime  @default(now())

  bookings Booking[]
  offers   JobOffer[]
  payouts  Payout[]

  @@index([status])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

/**
 * A job offered to a pro. First to accept wins; the rest expire.
 */
model JobOffer {
  id          String      @id @default(cuid())
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  pro         Pro         @relation(fields: [proId], references: [id], onDelete: Cascade)
  proId       String
  status      OfferStatus @default(PENDING)
  sentAt      DateTime    @default(now())
  respondedAt DateTime?

  @@unique([bookingId, proId])
  @@index([status])
}

model Booking {
  id               String        @id @default(cuid())
  ref              String        @unique // human-friendly, e.g. HMG-8F2A
  vertical         String        @default("cleaning")
  serviceSlug      String
  serviceName      String
  bedrooms         Int           @default(0)
  bathrooms        Int           @default(0)
  sqft             Int           @default(0)
  frequency        Frequency     @default(ONE_TIME)
  date             String // ISO date (YYYY-MM-DD)
  time             String
  quoteLow         Int?
  quoteHigh        Int?
  /**
   * Labour minutes the quote was built from. Shown to the pro before they
   * accept: a payout figure without a duration is not a decidable offer.
   */
  estimatedMinutes Int?
  status           BookingStatus @default(SCHEDULED)
  notes            String?
  createdAt        DateTime      @default(now())

  /**
   * Minutes the pro actually worked. Ground truth for calibrating the AI
   * time model — compare against VisionAnalysis.predictedMinutes.
   */
  actualMinutes Int?

  // Marketing attribution (first touch) and applied offer.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  promoCode   String?
  discount    Int? // USD off the subtotal

  // Automation lifecycle flags — guard against double-sends.
  remind24Sent      Boolean @default(false)
  remind2Sent       Boolean @default(false)
  reviewRequestSent Boolean @default(false)
  followUpSent      Boolean @default(false)

  customer       Customer        @relation(fields: [customerId], references: [id])
  customerId     String
  address        Address?        @relation(fields: [addressId], references: [id])
  addressId      String?
  pro            Pro?            @relation(fields: [proId], references: [id])
  proId          String?
  invoice        Invoice?
  review         Review?
  photos         Photo[]
  offers         JobOffer[]
  visionAnalysis VisionAnalysis?
  payout         Payout?

  @@index([status])
  @@index([createdAt])
  @@index([date])
  @@index([proId])
  @@index([utmSource])
}

// Before/after service photos (stored in Supabase Storage / S3; URL kept here).
model Photo {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  url       String
  kind      String   @default("after") // before | after
  createdAt DateTime @default(now())
}

model Invoice {
  id        String        @id @default(cuid())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String        @unique
  amount    Int
  status    InvoiceStatus @default(DRAFT)
  stripeId  String?
  createdAt DateTime      @default(now())
}

model Review {
  id         String   @id @default(cuid())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

/**
 * A completed AI walkthrough analysis.
 * `predictedMinutes` vs. the linked booking's `actualMinutes` is the training
 * signal for calibrating lib/vision/model.ts. Without capturing actuals the
 * time model can never improve, so this relationship is the point of the table.
 */
model VisionAnalysis {
  id               String   @id @default(cuid())
  serviceSlug      String
  city             String?
  frameCount       Int
  roomCount        Int
  predictedMinutes Int
  condition        String
  confidence       Float
  source           String // vision-llm | heuristic
  quoteLow         Int
  quoteHigh        Int
  /**
   * Full analysis payload (rooms, objects, soil scores) for auditing.
   */
  payload          Json
  contactEmail     String?
  createdAt        DateTime @default(now())

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?  @unique

  @@index([createdAt])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

/**
 * A pro's earnings for one job. Created when the booking completes and
 * reconciled against Stripe. Unique per booking so a job can only ever
 * generate one payout, however many times completion is triggered.
 */
model Payout {
  id               String       @id @default(cuid())
  booking          Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId        String       @unique
  pro              Pro          @relation(fields: [proId], references: [id])
  proId            String
  amount           Int // cents
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  failureReason    String?
  createdAt        DateTime     @default(now())
  paidAt           DateTime?

  @@index([status])
  @@index([proId])
}

/**
 * A labeled capture from a real job — the training asset.
 * The valuable record is not the footage, it is the PAIR: what the model
 * predicted and what the person standing in the room corrected it to, plus how
 * long the work actually took. That pair is the only thing that improves the
 * model, and it can't be bought or scraped.
 * `consent*` is mandatory, not decorative: footage of someone's home without
 * recorded permission is a liability, never an asset.
 */
model TrainingSample {
  id           String  @id @default(cuid())
  capturedBy   String // pro id or admin email
  serviceSlug  String
  city         String?
  propertyType String  @default("residential")

  // Consent record — who agreed, and when.
  consentName     String
  consentAt       DateTime
  /**
   * Whether the customer agreed the footage may improve the model.
   */
  consentTraining Boolean  @default(false)

  frameCount Int
  /**
   * The model's raw analysis.
   */
  predicted  Json
  /**
   * The human-corrected analysis — the label.
   */
  corrected  Json

  predictedMinutes    Int
  actualMinutes       Int
  /**
   * Mean absolute soil-score correction across all rooms, 0-100.
   */
  correctionMagnitude Float @default(0)

  /**
   * Operator context — the signal nobody outside the operation can collect.
   * The same bathroom at the same soil level does not take the same time at
   * 9am as it does on someone's fourth job of the day. Capturing who worked,
   * how far into their day they were, and how many hands were on the job is
   * what lets the time model explain variance that pure vision never will.
   */
  /**
   * /**
   * /**
   * /**
   * /** 1 = first job of that worker's day, 2 = second, etc.
   */
  jobSequence      Int?
  /**
   * Hours already worked before starting this job.
   */
  hoursWorkedToday Float?
  /**
   * People on the job. actualMinutes is person-minutes, so this is separate.
   */
  crewSize         Int    @default(1)
  /**
   * Local hour the job started, 0-23.
   */
  startHour        Int?

  /**
   * Measured floor area, when someone paced it out. Denormalised out of the
   * corrected JSON so "does area predict time" is a query rather than a scan
   * that parses every sample.
   */
  totalAreaSqft Int?

  /**
   * Post-service analysis, for quality scoring.
   */
  afterAnalysis Json?
  /**
   * 0-100 improvement score derived from before vs. after.
   */
  qualityScore  Float?

  notes     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([serviceSlug])
  @@index([jobSequence])
}

/**
 * Spent magic-link tokens, so a sign-in link can only be used once.
 */
model UsedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Marketing opt-out list. Checked before any promotional send (CAN-SPAM).
model OptOut {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Every quote/chat/contact intent is captured as a Lead for follow-up.
model Lead {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  source    String   @default("web") // web | chatbot | contact | voice
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * A company licensing the quoting engine.
 * The marketplace is tenant zero; every other row is a cleaning company that
 * pays for the API. Pricing and calibration are JSON because they are settings,
 * not relations — a new knob is a code change in lib/tenants/types.ts, never a
 * migration, which matters when the shape is still being learned from customers.
 */
model Tenant {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  contactEmail String
  plan         String  @default("trial")
  active       Boolean @default(true)
  monthlyQuota Int     @default(50)

  /**
   * SHA-256 of the API key. The key itself is shown once and never stored.
   */
  keyHash  String @unique
  /**
   * Last 4 chars, so a key can be identified in the UI without revealing it.
   */
  keyLast4 String

  /**
   * TenantPricing — rate, minimum, currency, tax, supply multiplier.
   */
  pricing     Json
  /**
   * TenantCalibration — the time model fitted to this tenant's own actuals.
   */
  calibration Json
  /**
   * TenantBranding — display name, logo, color for the embedded widget.
   */
  branding    Json

  createdAt DateTime      @default(now())
  usage     TenantUsage[]
  leads     TenantLead[]

  @@index([createdAt])
}

/**
 * Metered usage per tenant per calendar month (UTC), for billing and quota.
 */
model TenantUsage {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * "YYYY-MM", UTC.
   */
  period      String
  quotes      Int    @default(0)
  /**
   * Sum of quoted midpoints in the tenant's currency — their ROI, and ours.
   */
  quotedValue Float  @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, period])
  @@index([period])
}

/**
 * A quote request from a tenant's own customer, captured on their hosted page.
 * This is the tenant's lead, not ours. We store it so their dashboard can show
 * it and so a failed notification isn't a lost customer, but the relationship
 * belongs to them — which is also why nothing here is ever aggregated across
 * tenants or sold.
 */
model TenantLead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  address String?
  notes   String?

  serviceSlug String
  /**
   * The quote shown to the customer, in the tenant's currency.
   */
  quoteLow    Int
  quoteHigh   Int
  currency    String  @default("USD")
  minutes     Int
  condition   String?

  /**
   * Full analysis, so the tenant can see what the AI actually saw.
   */
  analysis Json?

  /**
   * new | contacted | won | lost
   */
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/**
 * One job, logged live from the field by chat.
 * Separate from Booking on purpose: these are recorded on jobs the operator
 * finds themselves, long before the platform has any bookings of its own, and
 * the whole reason they exist is to produce labelled minutes for the time
 * model when there is nothing else to learn from.
 */
model ActivitySession {
  id          String  @id @default(cuid())
  /**
   * Telegram chat id or admin email — whoever logged it.
   */
  loggedBy    String
  label       String?
  serviceSlug String?

  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  /**
   * Sum of the closed segments. Denormalised so reports don't re-add them.
   */
  totalMinutes Int?

  notes    String?
  segments ActivitySegment[]

  @@index([loggedBy, startedAt])
}

/**
 * One room, or one task inside a room, with a real start and end.
 */
model ActivitySegment {
  id        String          @id @default(cuid())
  sessionId String
  session   ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  roomType String
  /**
   * Free-form detail the person said, e.g. "cocina el horno".
   */
  task     String?

  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?

  @@index([sessionId])
  @@index([roomType])
}
